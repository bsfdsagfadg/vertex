package config

type staticConfig struct {
	c AppConfig
}

func StaticProvider(c AppConfig) ConfigProvider { return staticConfig{c} }

func (s staticConfig) PortAPI() int                      { return s.c.PortAPI }
func (s staticConfig) MaxRetries() int                   { return s.c.MaxRetries }
