func TestApplyImageConfig(t *testing.T) {
	// image_size 档位
	gp := map[string]any{}
	ApplyImageConfig(gp, map[string]any{"image_size": "2K"}, "gemini-3.1-flash-image")
	if gp["generationConfig"].(map[string]any)["imageConfig"].(map[string]any)["imageSize"] != "2K" {
