	q := make(url.Values)
	if up, _ := cfg["up"].(string); up != "" {
		q.Set("up", up)
	}
	if down, _ := cfg["down"].(string); down != "" {
		q.Set("down", down)
	}
	if sni, _ := cfg["sni"].(string); sni != "" {
		q.Set("sni", sni)
