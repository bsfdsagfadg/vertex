	if !strings.HasPrefix(uri, "trojan://") {
		t.Fatalf("expected trojan://, got %s", uri)
	}

	parsed, err := ParseURI(uri)
	if err != nil {
		t.Fatalf("ParseURI failed: %v", err)
	}
	if parsed["password"] != "pass" || parsed["sni"] != "example.com" {
