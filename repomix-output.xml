	if queryFlag(query, "allowInsecure", "insecure") {
		out["skip-cert-verify"] = true
	}
	if obfs := query.Get("obfs"); obfs != "" {
		out["obfs"] = obfs
	}
	if alpn := query.Get("alpn"); alpn != "" {
