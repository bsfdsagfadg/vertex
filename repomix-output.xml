// makeResult 构造一个最小 Gemini 响应：candidates[0].content.parts = parts。
func makeResult(parts []any) map[string]any {
	return map[string]any{
		"candidates": []any{
			map[string]any{
				"content": map[string]any{"parts": parts},
			},
