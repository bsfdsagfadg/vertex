	if err = GlobalDB.QueryRow("SELECT source FROM nodes WHERE raw_uri = 'uri-a'").Scan(&oldColumn); err != nil {
		t.Fatal(err)
	}
	if oldColumn != "" {
		t.Fatalf("legacy source column must be cleared after migration: %q", oldColumn)
