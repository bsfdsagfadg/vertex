	if len(gp4) != 0 {
		t.Errorf("无分辨率参数时不应改 payload: %v", gp4)
	}

	// 能力矩阵过滤不支持的档位。
	gp5 := map[string]any{}
	ApplyImageConfig(gp5, map[string]any{"image_size": "4K"}, "gemini-3.1-flash-lite-image")
